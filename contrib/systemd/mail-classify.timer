[Unit]
Description=Run mail-classify periodically
Documentation=https://github.com/initrd/himalaya-jev-mail-classify

[Timer]
# OnCalendar, not OnUnitActiveSec: monotonic specs are discarded once their
# computed elapse is in the past, so any restarted user manager stops the timer
# for good. OnCalendar always has a next elapse, and it is the only form
# Persistent=true applies to.
OnCalendar=hourly
# Catch up a missed run on next start. Safe because a run is idempotent: Gmail is
# the queue, and the sentinel label means nothing is ever processed twice.
Persistent=true
Unit=mail-classify.service

[Install]
WantedBy=timers.target
